APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# KETERANGAN OPSI POSTGRESQL:
# sslmode=disable  : Wajib untuk koneksi ke localhost/server internal yang tidak memiliki sertifikat SSL aktif. Jika ke cloud (RDS/CloudSQL), gunakan sslmode=require.
# search_path      : (Opsional) Mengunci schema spesifik (contoh: staging atau dbo). Jika tidak diisi, default akan menggunakan schema 'public'.

POSTGRES_MAXTOP_URL=postgres://<user>:<password>@<server>:<port>/<database>?sslmode=disable&search_path=<schema>
MSSQL_MAXTOP_URL=sqlserver://<user>:<password>@<server>:<port>?database=<database>

POSTGRES_PANDORA_URL=postgres://<user>:<password>@<server>:<port>/<database>?sslmode=disable&search_path=<schema>
MSSQL_PANDORA_URL=sqlserver://<user>:<password>@<server>:<port>?database=<database>

POSTGRES_TOPLINK_URL=postgres://<user>:<password>@<server>:<port>/<database>?sslmode=disable&search_path=<schema>
MSSQL_TOPLINK_URL=sqlserver://<user>:<password>@<server>:<port>?database=<database>

JWT_SECRET=<jwt-secret-acak-32-byte>
JWT_ISSUER=<nama-proyek>
JWT_TOKEN_DURATION=24h

GLOBAL_LOCAL_ONLY=true
POSTGRES_WRITE_ENABLED=false

# Daftar IP/CIDR proxy yang dipercaya (dipisah koma). Kosongkan jika API diakses langsung tanpa proxy.
# Header X-Forwarded-For/X-Real-IP HANYA dihormati dari proxy yang ada di daftar ini.
# Contoh bila di belakang nginx: TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# Wajib diputuskan saat APP_ENV=production dan GLOBAL_LOCAL_ONLY=true:
# true  = klien terhubung LANGSUNG ke API (tanpa proxy), RemoteAddr adalah IP asli klien.
# false = WAJIB isi TRUSTED_PROXIES dengan IP/CIDR proxy, atau server menolak start.
ALLOW_DIRECT_CLIENTS=false

# Batas maksimum ukuran body request dalam byte (default 1 MB)
MAX_BODY_BYTES=1048576

# Cookie login hanya dikirim lewat HTTPS. Set false saat dev via HTTP (LAN/localhost).
COOKIE_SECURE=true

# ===== Pool Koneksi Database (opsional; angka berikut sudah default aman) =====
# POSTGRES_MAX_CONNS   : jumlah maksimum koneksi paralel ke Postgres per tenant.
# POSTGRES_MIN_CONNS   : koneksi idle yang dijaga tetap hidup.
# POSTGRES_MAX_CONN_IDLE_TIME : koneksi menganggur lebih lama dari ini ditutup.
# POSTGRES_MAX_CONN_LIFETIME  : koneksi ditutup setelah dipakai selama ini (mencegah koneksi mati diam-diam).
# POSTGRES_HEALTH_CHECK_PERIOD: interval pengecekan kesehatan koneksi.
# PERHATIAN: jangan melebihi max_connections server Postgres (total semua tenant).
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=0
POSTGRES_MAX_CONN_IDLE_TIME=5m
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_HEALTH_CHECK_PERIOD=1m

MSSQL_MAX_OPEN_CONNS=10
MSSQL_MAX_IDLE_CONNS=5
MSSQL_MAX_CONN_LIFETIME=30m

# ===== Rate Limit (request/detik + burst maksimum) =====
# PERHATIAN: kapasitas 0 = semua request diblok (fail-closed), jangan set 0.
RATE_LIMIT_GLOBAL_RATE=50
RATE_LIMIT_GLOBAL_CAPACITY=100
RATE_LIMIT_LOGIN_RATE=0.2
RATE_LIMIT_LOGIN_CAPACITY=5
RATE_LIMIT_CLEANUP_INTERVAL=3m

# ===== Timeout HTTP Server =====
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=10s

# ===== CORS =====
CORS_MAX_AGE=300

# Lokasi file daftar API key (relative atau absolut). File TIDAK boleh masuk git.
# Generate via: go run cmd/keygen/main.go "Nama Developer"
API_KEYS_PATH=api_keys.json
