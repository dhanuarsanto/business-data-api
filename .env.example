APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# KETERANGAN OPSI POSTGRESQL:
# sslmode=disable  : Wajib untuk koneksi ke localhost/server internal yang tidak memiliki sertifikat SSL aktif. Jika ke cloud (RDS/CloudSQL), gunakan sslmode=require.
# search_path      : (Opsional) Mengunci schema spesifik (contoh: staging atau dbo). Jika tidak diisi, default akan menggunakan schema 'public'.

POSTGRES_MAXTOP_URL=postgres://<user>:<password>@<server>:<port>/<database>?sslmode=disable&search_path=<schema>
MSSQL_MAXTOP_URL=sqlserver://<user>:<password>@<server>:<port>?database=<database>

POSTGRES_PANDORA_URL=postgres://<user>:<password>@<server>:<port>/<database>?sslmode=disable&search_path=<schema>
MSSQL_PANDORA_URL=sqlserver://<user>:<password>@<server>:<port>?database=<database>

POSTGRES_TOPLINK_URL=postgres://<user>:<password>@<server>:<port>/<database>?sslmode=disable&search_path=<schema>
MSSQL_TOPLINK_URL=sqlserver://<user>:<password>@<server>:<port>?database=<database>

JWT_SECRET=<jwt-secret-acak-32-byte>
JWT_ISSUER=<nama-proyek>
JWT_TOKEN_DURATION=24h

GLOBAL_LOCAL_ONLY=false
POSTGRES_WRITE_ENABLED=false
